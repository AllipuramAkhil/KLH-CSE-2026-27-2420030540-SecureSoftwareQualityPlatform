# ============================================================
# ASSQP Backend - Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.
# ============================================================

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Database (MySQL) ---
DB_URL=jdbc:mysql://localhost:3306/assqp
DB_USERNAME=root
DB_PASSWORD=your_database_password
DDL_AUTO=update
SHOW_SQL=false

# --- JWT ---
# JWT_SECRET must be a long, random, high-entropy string (256+ bits) in production.
JWT_SECRET=your_secure_jwt_secret
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# --- AI Provider (optional) ---
# If left blank, the platform automatically falls back to rule-based
# analysis for test generation, defect explanation, vulnerability
# explanation, and risk explanation. No functionality is lost.
AI_API_KEY=your_ai_api_key
AI_API_URL=your_ai_api_url
AI_API_MODEL=claude-sonnet-4-6

# --- File Storage ---
UPLOAD_DIR=./uploads

# --- Coverage (JaCoCo) ---
# Path to this backend's own JaCoCo XML report (see pom.xml jacoco-maven-plugin).
# Used by POST /api/projects/{id}/coverage/import. CI/CD can instead POST the
# report file directly to /api/projects/{id}/coverage/import-file.
JACOCO_REPORT_PATH=./target/site/jacoco/jacoco.xml

# --- SonarQube (Phase 4, optional) ---
SONAR_HOST_URL=
SONAR_TOKEN=
SONAR_PROJECT_KEY=

# --- Trivy (Phase 5, optional) ---
TRIVY_BINARY_PATH=trivy
TRIVY_SCAN_TARGET=.

# --- OWASP ZAP (Phase 6, optional) ---
# Live scanning needs both a running ZAP daemon AND every target listed in
# ZAP_ALLOWED_TARGETS - see backend/README section on Phase 6, or the root
# .env.example. Leave ZAP_API_URL blank to rely on import-file only.
ZAP_API_URL=
ZAP_API_KEY=
ZAP_ALLOWED_TARGETS=
ZAP_SCAN_TIMEOUT_SECONDS=120

# --- ML Risk Prediction Service (Phase 8, optional) ---
# Run `uvicorn app.main:app --port 8000` from ml-service/ locally, then:
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_SECONDS=10

# --- Git Code Churn (Phase 9, optional) ---
# '.' works if you run the backend from inside the project checkout.
GIT_REPO_PATH=.
GIT_CHURN_LOOKBACK_DAYS=90
GIT_CHURN_MAX_COMMITS=500

# --- Logging ---
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN
